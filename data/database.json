      "id": "proto_shooting",
      "title": "Tactical Silent Threat / Active Shooter Drill",
      "type": "Tactical Threat",
      "threatLevel": "CRITICAL",
      "safeZones": "Classrooms, AVR, Gym Interior Barricade",
      "directives": [
        "Lock and barricade all doors immediately with heavy furniture.",
        "Silence all mobile devices (zero sound/vibration).",
        "Turn off all lights and digital projectors (OLED Blackout mode).",
        "Stay flat on floor away from doors and exterior windows.",
        "Await official SSG & Marshal all-clear broadcast before unlocking."
      ],
      "activeBroadcast": false,
      "updatedAt": "2026-10-05T12:00:00.000Z"
    },
