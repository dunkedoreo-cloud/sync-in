      "type": "Natural Hazard",
      "threatLevel": "HIGH",
      "safeZones": "University Athletic Oval & Open Grandstand",
      "directives": [
        "Duck, Cover, and Hold during initial tremors.",
        "Evacuate through designated structural stairwells — DO NOT use elevators.",
        "Proceed calmly to the Open Field Assembly Area.",
        "Faculty marshals take headcounts using Faculty Attendance Portal."
      ],
      "activeBroadcast": false,
      "updatedAt": "2026-10-05T12:00:00.000Z"
    },
